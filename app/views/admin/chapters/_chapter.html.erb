<% if @report_date %>
<div class="row g-3 mb-3">
  <div class="col-md-4">
    <div class="card h-100">
      <div class="card-body">
        <div class="text-muted small">Net Membership Change</div>
        <% if @stale_comparison %>
        <div class="display-6 text-muted">--</div>
        <div class="small text-muted">No reports since <%= @last_change_date.strftime('%-m/%-d/%Y') %></div>
        <% elsif @manpower_net_change %>
        <% net_change_class = @manpower_net_change.positive? ? 'text-success' : (@manpower_net_change.negative? ? 'text-danger' : 'text-muted') %>
        <% net_change_prefix = @manpower_net_change.positive? ? '+' : '' %>
        <div class="display-6 <%= net_change_class %>"><%= net_change_prefix %><%= @manpower_net_change %></div>
        <div class="small text-muted">Compared to <%= @compare_date.strftime('%-m/%-d/%Y') %></div>
        <% else %>
        <div class="display-6 text-muted">--</div>
        <div class="small text-muted">No report on <%= @compare_date.strftime('%-m/%-d/%Y') %></div>
        <% end %>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card h-100">
      <div class="card-body">
        <div class="text-muted small">Growth Rate</div>
        <% if @stale_comparison %>
        <div class="display-6 text-muted">--</div>
        <div class="small text-muted">Chapter is dormant</div>
        <% elsif @manpower_growth_rate %>
        <% growth_class = @manpower_growth_rate.positive? ? 'text-success' : (@manpower_growth_rate.negative? ? 'text-danger' : 'text-muted') %>
        <% growth_prefix = @manpower_growth_rate.positive? ? '+' : '' %>
        <div class="display-6 <%= growth_class %>"><%= growth_prefix %><%= @manpower_growth_rate %>%</div>
        <div class="small text-muted">Since <%= @compare_date.strftime('%-m/%-d/%Y') %></div>
        <% else %>
        <div class="display-6 text-muted">--</div>
        <div class="small text-muted">Requires non-zero comparison baseline</div>
        <% end %>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card h-100">
      <div class="card-body">
        <div class="text-muted small"><%= chapter.status ? 'Current Manpower' : 'Last Reported Manpower' %></div>
        <div class="display-6"><%= @report_manpower %></div>
        <div class="small text-muted"><%= @report_date.strftime('%-m/%-d/%Y') %></div>
      </div>
    </div>
  </div>
</div>
<% end %>

<div id="<%= dom_id chapter %>" class="card mb-3">
  <div class="card-body">
    <div class="row">
      <div class="col-md-7">
        <dl class="row">
          <dt class="col-md-4">Name</dt>
          <dd class="col-md-8"><%= link_to chapter.name, admin_chapter_path(chapter) %></dd>
          <dt class="col-md-4">Institution Name</dt>
          <dd class="col-md-8"><%= chapter.institution_name %></dd>
          <dt class="col-md-4">Chapter Roll</dt>
          <dd class="col-md-8"><%= chapter.chapter_roll %></dd>
          <dt class="col-md-4">Charter Date</dt>
          <dd class="col-md-8"><%= chapter.charter_date ? chapter.charter_date.strftime('%-m/%-d/%Y') : 'Not Set' %></dd>
          <dt class="col-md-4">SigEp Learning Community</dt>
          <dd class="col-md-8"><%= chapter.slc ? 'Yes' : 'No' %></dd>
          <dt class="col-md-4">Active?</dt>
          <dd class="col-md-8"><%= chapter.status ? 'Yes' : 'No' %></dd>
          <dt class="col-md-4">Expansion?</dt>
          <dd class="col-md-8"><%= chapter.expansion ? 'Yes' : 'No' %></dd>
          <dt class="col-md-4">Manpower</dt>
          <dd class="col-md-8"><%= chapter.manpower %></dd>
          <dt class="col-md-4">City</dt>
          <dd class="col-md-8"><%= chapter.city %></dd>
          <dt class="col-md-4">State</dt>
          <dd class="col-md-8"><%= chapter.state %></dd>
          <dt class="col-md-4">Website</dt>
          <dd class="col-md-8">
            <% unless chapter.website.blank? %>
            <%= link_to chapter.website, chapter.website %>
            <% else %>
            <span class="text-muted">Not Set</span>
            <% end %>
          </dd>
          <dt class="col-md-4">District</dt>
          <% if chapter.district %>
          <dd class="col-md-8"><%= link_to(chapter.district.name, admin_district_path(chapter.district)) %></dd>
          <% else %>
          <dd class="col-md-8 text-muted">Not Set</dd>
          <% end %>
          <dt class="col-md-4">Latitude</dt>
          <dd class="col-md-8"><tt><%= chapter.latitude %></tt></dd>
          <dt class="col-md-4">Longitude</dt>
          <dd class="col-md-8"><tt><%= chapter.longitude %></tt></dd>
        </dl>
      </div>
      <div class="col-md-5">
        <div id="map" class="map-box-form" data-controller="map" data-map-url-value="<%= admin_chapter_path(chapter, format: :json) %>"></div>
      </div>
    </div>
  </div>
</div>
<% unless current_page?(admin_chapters_url) %>
<div class="card mb-3">
  <div class="card-body">
    <div id="manpower_chart">
      <%= line_chart @manpower_survey, title: 'Daily Reported Manpower', points: false, library: { spanGaps: false } %>
    </div>
  </div>
</div>
<% end %>

