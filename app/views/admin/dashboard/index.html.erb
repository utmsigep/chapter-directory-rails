<% content_for :title, 'Dashboard' %>

<%= render 'admin/admin_menu' %>

<div class="d-flex flex-column flex-lg-row align-items-lg-start justify-content-between gap-3 mb-3">
  <div class="text-center text-md-start">
    <h1>Dashboard</h1>
    <div class="small text-muted">
      <% if @refresh_status == :queued %>
        <span class="badge text-bg-warning">Refresh queued</span>
        Latest available survey: <%= @latest_survey_date ? @latest_survey_date.strftime('%-m/%-d/%Y') : 'None yet' %>
      <% elsif @refresh_status == :available %>
        <span class="badge text-bg-success">Data current</span>
        Latest available survey: <%= @latest_survey_date&.strftime('%-m/%-d/%Y') %>
      <% elsif @refresh_status == :historical %>
        <span class="badge text-bg-secondary">Historical view</span>
      <% else %>
        <span class="badge text-bg-secondary">Data pending</span>
        Latest available survey: <%= @latest_survey_date ? @latest_survey_date.strftime('%-m/%-d/%Y') : 'None yet' %>
      <% end %>
      <% if @compare_preset_label.present? %>
        <span class="ms-2">Preset: <strong><%= @compare_preset_label %></strong></span>
      <% end %>
    </div>
  </div>
  <%= form_with(url: admin_path(), method: :get, local: true, id: 'dashboard_date_form', class: 'row g-2 align-items-end') do |form| %>
    <div class="col-auto">
      <%= form.label :date, 'Report', class: 'form-label mb-1 small text-muted' %>
      <%= form.date_field :date, value: @report_date, class: 'form-control' %>
    </div>
    <div class="col-auto">
      <%= form.label :compare, 'Compare', class: 'form-label mb-1 small text-muted' %>
      <%= form.date_field :compare, value: @compare_date, class: 'form-control' %>
    </div>
    <div class="col-auto">
      <%= form.button 'Apply', name: nil, type: :submit, class: 'btn btn-primary' %>
    </div>
  <% end %>
</div>

<div class="d-flex flex-wrap gap-2 mb-3">
  <% @preset_shortcuts.each do |shortcut| %>
    <% active_preset = shortcut[:key] == @compare_preset %>
    <% button_class = active_preset ? 'btn btn-sm btn-primary' : 'btn btn-sm btn-outline-secondary' %>
    <%= link_to shortcut[:label], admin_path(date: @report_date, compare: shortcut[:compare_date], preset: shortcut[:key]), class: button_class %>
  <% end %>
</div>

<div class="row g-3 mb-3">
  <div class="col-md-3">
    <div class="card h-100">
      <div class="card-body">
        <div class="text-muted small">Net Membership Change</div>
        <% net_change_class = @net_manpower_change.positive? ? 'text-success' : (@net_manpower_change.negative? ? 'text-danger' : 'text-muted') %>
        <% net_change_prefix = @net_manpower_change.positive? ? '+' : '' %>
        <div class="display-6 <%= net_change_class %>"><%= net_change_prefix %><%= number_with_delimiter(@net_manpower_change) %></div>
        <div class="small text-muted">Compared to <%= @compare_date.strftime('%-m/%-d/%Y') %></div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card h-100">
      <div class="card-body">
        <div class="text-muted small">Growth Rate</div>
        <% if @net_manpower_growth_rate.nil? %>
          <div class="display-6 text-muted">--</div>
          <div class="small text-muted">Requires non-zero comparison baseline</div>
        <% else %>
          <% growth_class = @net_manpower_growth_rate.positive? ? 'text-success' : (@net_manpower_growth_rate.negative? ? 'text-danger' : 'text-muted') %>
          <% growth_prefix = @net_manpower_growth_rate.positive? ? '+' : '' %>
          <div class="display-6 <%= growth_class %>"><%= growth_prefix %><%= @net_manpower_growth_rate %>%</div>
          <div class="small text-muted">Manpower growth over selected window</div>
        <% end %>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card h-100">
      <div class="card-body">
        <div class="text-muted small">Chapter Movement Mix</div>
        <div class="mt-2">
          <span class="badge text-bg-success me-1">Up: <%= @chapters_up_count %></span>
          <span class="badge text-bg-secondary me-1">Flat: <%= @chapters_flat_count %></span>
          <span class="badge text-bg-danger">Down: <%= @chapters_down_count %></span>
        </div>
        <div class="small text-muted mt-2">Based on <%= number_with_delimiter(@chapters_compared_count) %> chapters with report or compare data</div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card h-100">
      <div class="card-body">
        <div class="text-muted small">Reporting Coverage</div>
        <% if @reporting_coverage_rate.nil? %>
          <div class="display-6 text-muted">--</div>
        <% else %>
          <div class="display-6"><%= @reporting_coverage_rate %>%</div>
        <% end %>
        <div class="small text-muted"><%= number_with_delimiter(@reporting_chapters_count) %> of <%= number_with_delimiter(@active_chapter_total) %> active chapters reported for <%= @report_date.strftime('%-m/%-d') %></div>
      </div>
    </div>
  </div>
</div>

<div class="row g-3 mb-3">
  <div class="col-md-3">
    <div class="card h-100">
      <div class="card-body">
        <div class="text-muted small">Active Chapters</div>
        <div class="display-6"><%= number_with_delimiter(@active_chapters) %></div>
        <% if @report_date == Date.today %>
        <div class="small text-muted">
          <img src="<%= asset_path('chapter-slc.svg') %>" alt="SLC Icon" width="14"> <%= number_with_delimiter(Chapter.where(status: 1, slc: 1).size) %> SLC
          <span class="mx-1">|</span>
          <img src="<%= asset_path('chapter.svg') %>" alt="Chapter Icon" width="14"> <%= number_with_delimiter(Chapter.where(status: 1, slc: 0).size) %> Non-SLC
        </div>
        <% end %>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card h-100">
      <div class="card-body">
        <div class="text-muted small">Reported Manpower</div>
        <div class="display-6"><%= number_with_delimiter(@current_manpower) %></div>
        <div class="small text-muted"><%= @report_date.strftime('%-m/%-d/%Y') %></div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card h-100">
      <div class="card-body">
        <div class="text-muted small">Average Chapter Size</div>
        <div class="display-6"><%= @average_chapter_size.round if @average_chapter_size > 0 %></div>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card h-100">
      <div class="card-body">
        <div class="text-muted small">Median Chapter Size</div>
        <div class="display-6"><%= @median_chapter_size %></div>
      </div>
    </div>
  </div>
</div>

<div class="row g-3 mb-3">
  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <h5 class="mb-0">Expansion vs Non-Expansion</h5>
          <span class="badge text-bg-light border">Window: <%= @comparison_window_label %></span>
        </div>
        <div class="table-responsive">
          <table class="table table-sm align-middle mb-0">
            <thead>
              <tr>
                <th>Group</th>
                <th class="text-end">Chapters</th>
                <th class="text-end">Report</th>
                <th class="text-end">Compare</th>
                <th class="text-end">Net</th>
                <th class="text-end">Growth</th>
              </tr>
            </thead>
            <tbody>
              <% @expansion_comparison.each do |row| %>
                <% change_class = row[:net_change].positive? ? 'text-success' : (row[:net_change].negative? ? 'text-danger' : 'text-muted') %>
                <% change_prefix = row[:net_change].positive? ? '+' : '' %>
                <% growth_prefix = row[:growth_rate].to_f.positive? ? '+' : '' %>
                <tr>
                  <td><strong><%= row[:label] %></strong></td>
                  <td class="text-end"><%= number_with_delimiter(row[:chapters]) %></td>
                  <td class="text-end"><%= number_with_delimiter(row[:report_manpower]) %></td>
                  <td class="text-end"><%= number_with_delimiter(row[:compare_manpower]) %></td>
                  <td class="text-end <%= change_class %>"><%= change_prefix %><%= number_with_delimiter(row[:net_change]) %></td>
                  <td class="text-end"><%= row[:growth_rate].nil? ? '--' : "#{growth_prefix}#{row[:growth_rate]}%" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <h5 class="mb-0">SLC vs Non-SLC</h5>
          <span class="badge text-bg-light border">Window: <%= @comparison_window_label %></span>
        </div>
        <div class="table-responsive">
          <table class="table table-sm align-middle mb-0">
            <thead>
              <tr>
                <th>Group</th>
                <th class="text-end">Chapters</th>
                <th class="text-end">Report</th>
                <th class="text-end">Compare</th>
                <th class="text-end">Net</th>
                <th class="text-end">Growth</th>
              </tr>
            </thead>
            <tbody>
              <% @slc_comparison.each do |row| %>
                <% change_class = row[:net_change].positive? ? 'text-success' : (row[:net_change].negative? ? 'text-danger' : 'text-muted') %>
                <% change_prefix = row[:net_change].positive? ? '+' : '' %>
                <% growth_prefix = row[:growth_rate].to_f.positive? ? '+' : '' %>
                <tr>
                  <td><strong><%= row[:label] %></strong></td>
                  <td class="text-end"><%= number_with_delimiter(row[:chapters]) %></td>
                  <td class="text-end"><%= number_with_delimiter(row[:report_manpower]) %></td>
                  <td class="text-end"><%= number_with_delimiter(row[:compare_manpower]) %></td>
                  <td class="text-end <%= change_class %>"><%= change_prefix %><%= number_with_delimiter(row[:net_change]) %></td>
                  <td class="text-end"><%= row[:growth_rate].nil? ? '--' : "#{growth_prefix}#{row[:growth_rate]}%" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
  <h5 class="mb-0">Trend Views</h5>
  <span class="badge text-bg-light border">Window: <%= @comparison_window_label %></span>
</div>

<div class="row mb-3">
  <div class="col-md-6">
    <div id="manpower_chart" class="my-3">
      <%= line_chart @manpower_survey, title: 'Daily Reported Manpower', thousands: ',', download: { filename: "daily-reported-manpower-#{@report_date}.png", background: "#ffffff" }, library: {
          scales: {
            y: {
              type: 'linear',
              display: true,
              position: 'left'
            },
            y1: {
              type: 'linear',
              display: true,
              position: 'right',
              yTitle: 'Chapters',
              suggestedMax: 300,
              suggestedMin: 0
            },
          }
      } %>
    </div>
  </div>
  <div class="col-md-6">
    <div id="manpower_distribution" class="my-3">
      <%= column_chart @manpower_distribution, title: 'Manpower Distribution', download: { filename: "manpower-distribution-#{@report_date}.png", background: "#ffffff" }, library: {
        scales: {
          x: {
            display: false
          }
        }
      } %>
    </div>
  </div>
</div>

<% if @report_date != @compare_date %>
<div class="d-flex justify-content-between align-items-center mb-2">
  <h5 class="mb-0">District Change Views</h5>
  <span class="badge text-bg-light border">Window: <%= @comparison_window_label %></span>
</div>
<div class="row mb-3">
  <div class="col-md-6">
    <div id="district_net_gain" class="my-3">
      <%= column_chart @district_net_gain_chart, title: 'Top District Membership Gains', thousands: ',', download: { filename: "district-net-gain-#{@report_date}-vs-#{@compare_date}.png", background: "#ffffff" } %>
    </div>
  </div>
  <div class="col-md-6">
    <div id="district_net_decline" class="my-3">
      <%= column_chart @district_net_decline_chart, title: 'Top District Membership Declines (Absolute)', thousands: ',', download: { filename: "district-net-decline-#{@report_date}-vs-#{@compare_date}.png", background: "#ffffff" } %>
    </div>
  </div>
</div>

<div class="row mb-3">
  <div class="col-12">
    <h5 class="mb-2">District Net Change Snapshot</h5>
    <div class="table-responsive">
      <table class="table table-sm table-striped mb-0">
        <thead>
          <tr>
            <th>District</th>
            <th class="text-end">Chapters</th>
            <th class="text-end">Net Change</th>
          </tr>
        </thead>
        <tbody>
          <% @district_net_change_table.each do |district_name, stats| %>
            <% delta_class = stats[:delta].positive? ? 'text-success' : (stats[:delta].negative? ? 'text-danger' : 'text-muted') %>
            <% delta_prefix = stats[:delta].positive? ? '+' : '' %>
            <tr>
              <td><%= district_name %></td>
              <td class="text-end"><%= number_with_delimiter(stats[:chapters]) %></td>
              <td class="text-end <%= delta_class %>"><%= delta_prefix %><%= number_with_delimiter(stats[:delta]) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<% end %>

<div class="d-flex justify-content-between align-items-center mb-2">
  <h5 class="mb-0">Chapter Rankings</h5>
  <span class="badge text-bg-light border">Window: <%= @comparison_window_label %></span>
</div>

<div class="row mb-3">
  <div class="col-md-6 my-3">
    <% if @report_date != @compare_date %>
    <%= render partial: 'admin/dashboard/manpower_change_ranking_table', locals: { title: 'Increased Manpower', chapters: @chapter_increases } %>
    <% end %>
    <%= render partial: 'admin/dashboard/manpower_ranking_table', locals: { title: 'Largest Chapters', chapters: @largest_chapters } %>
  </div>
  <div class="col-md-6 my-3">
    <% if @report_date != @compare_date %>
    <%= render partial: 'admin/dashboard/manpower_change_ranking_table', locals: { title: 'Decreased Manpower', chapters: @chapter_decreases } %>
    <% end %>
    <%= render partial: 'admin/dashboard/manpower_ranking_table', locals: { title: 'Smallest Chapters', chapters: @smallest_chapters } %>
  </div>
</div>

<script>
const initializeDashboardControls = () => {
  document.querySelectorAll('a[data-toggle="toggle-table-rows"]').forEach((link) => {
    if (link.dataset.bound === 'true') {
      return;
    }

    link.dataset.bound = 'true';
    link.addEventListener('click', (event) => {
      event.preventDefault();

      const tableId = link.getAttribute('data-table-id');
      const table = document.getElementById(tableId);
      if (!table) {
        return;
      }

      table.querySelectorAll('tr.collapse').forEach((row) => {
        row.classList.toggle('show');
      });

      if (link.textContent.trim() === 'Expand') {
        link.innerHTML = '<i class="fa fa-caret-up fa-fw me-1"></i>Collapse';
      } else {
        link.innerHTML = '<i class="fa fa-caret-down fa-fw me-1"></i>Expand';
      }
    });
  });
};

initializeDashboardControls();
document.addEventListener('turbo:load', initializeDashboardControls);
</script>
