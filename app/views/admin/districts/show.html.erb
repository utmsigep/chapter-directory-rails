<% content_for :title, @district.name %>

<%= render 'admin/admin_menu' %>

<div class="row mb-3">
  <div class="col-md text-center text-md-start">
    <h1><%= @district.name %></h1>
  </div>
  <div class="col-md text-center text-md-end">
    <% if role_check(:editor) %>
    <%= link_to raw('<i class="fas fa-pencil"></i> Edit'), edit_admin_district_path(@district), class: 'btn btn-secondary' %>
    <% end %>
  </div>
</div>

<% if @preset_shortcuts.present? %>
<%= render 'admin/preset_shortcuts', preset_shortcuts: @preset_shortcuts, compare_preset: @compare_preset,
                                     preset_path: ->(shortcut) { admin_district_path(@district, date: @report_date, compare: shortcut[:compare_date], preset: shortcut[:key]) } %>
<% end %>

<%= render @district %>

<% if role_check(:editor) %>
<div class="my-3">
  <%= button_to "Delete District", admin_district_path(@district), method: :delete, class: 'btn btn-danger d-none' %>
</div>
<% end %>
