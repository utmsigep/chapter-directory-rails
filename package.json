{
  "name": "app",
  "dependencies": {
    "@hotwired/stimulus": "^3.2.1",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.0",
    "chart.js": "^4.4.1",
    "chartkick": "^5.0.1",
    "datatables.net": "^1.13.5",
    "datatables.net-bs5": "^1.13.5",
    "jquery": "^3.7.0",
    "maplibre-gl": "^6.6.0",
    "sass": "^1.64.1",
    "webpack": "^5.104.1",
    "webpack-cli": "^5.1.4"
  },
  "scripts": {
    "build": "webpack --config webpack.config.js && yarn copy:maplibre-worker",
    "watch": "webpack --watch --config webpack.config.js",
    "build:css": "sass ./app/assets/stylesheets/application.bootstrap.scss ./app/assets/builds/application.css --no-source-map --load-path=node_modules",
    "copy:maplibre-worker": "node -e \"var fs=require('fs');fs.mkdirSync('public/maplibre',{recursive:true});['maplibre-gl-worker.mjs','maplibre-gl-shared.mjs'].forEach(function(f){fs.copyFileSync('node_modules/maplibre-gl/dist/'+f,'public/maplibre/'+f)})\"",
    "postinstall": "yarn copy:maplibre-worker"
  },
  "devDependencies": {
    "eslint": "^8.45.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.27.5"
  },
  "volta": {
    "node": "24.16.0",
    "yarn": "4.1.0"
  }
}
